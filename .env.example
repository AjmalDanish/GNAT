# ============================================================================
# Global Network Anomaly Tracker (GNAT) - Environment Variables
# ============================================================================
# Copy this file to .env and fill in actual values.
# Never commit .env to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# Django Core Settings
# ----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-here-change-in-production-minimum-50-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# ----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------------------------------------
DATABASE_NAME=gnat_db
DATABASE_USER=gnat_user
DATABASE_PASSWORD=your-database-password-here
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://gnat_user:your-database-password-here@localhost:5432/gnat_db

# ----------------------------------------------------------------------------
# Redis Configuration (Celery + Caching)
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=64379
REDIS_DB=0

# ----------------------------------------------------------------------------
# Celery Configuration
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_ACKS_LATE=True
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# ----------------------------------------------------------------------------
# Time and Locale
# ----------------------------------------------------------------------------
TIME_ZONE=UTC
LANGUAGE_CODE=en-us
USE_I18N=True
USE_TZ=True

# ----------------------------------------------------------------------------
# Email Configuration (SMTP)
# ----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password-here
DEFAULT_FROM_EMAIL=noreply@gnat.example.com
ADMINS=admin@example.com

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# ----------------------------------------------------------------------------
# File Storage Paths
# ----------------------------------------------------------------------------
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
DATA_ROOT=/app/data
MODEL_ROOT=/app/models
LOG_ROOT=/app/logs

# ----------------------------------------------------------------------------
# AI/ML Configuration
# ----------------------------------------------------------------------------
MODEL_CHECKPOINT_DIR=/app/models/checkpoints
MODEL_EXPORT_DIR=/app/models/exported
MODEL_TRAINED_DIR=/app/models/trained

# Training defaults
DEFAULT_EPOCHS=100
DEFAULT_BATCH_SIZE=32
DEFAULT_LEARNING_RATE=0.001
DEFAULT_OPTIMIZER=adam

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
TORCH_DEVICE=cuda

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
API_V1_PREFIX=api/v1
DRF_DEFAULT_PAGINATION_CLASS=rest_framework.pagination.PageNumberPagination
DRF_PAGE_SIZE=20

# ----------------------------------------------------------------------------
# CORS Configuration
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_FORMAT=verbose
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=10

# ----------------------------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------------------------
RATELIMIT_ENABLE=False
RATELIMIT_VIEW=100/1m
RATELIMIT_API=1000/1h

# ----------------------------------------------------------------------------
# Session Configuration
# ----------------------------------------------------------------------------
SESSION_COOKIE_AGE=86400
SESSION_SAVE_EVERY_REQUEST=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# ----------------------------------------------------------------------------
# Password Validation
# ----------------------------------------------------------------------------
AUTH_PASSWORD_VALIDATORS=django.contrib.auth.password_validation.UserAttributeSimilarityValidator,django.contrib.auth.password_validation.MinimumLengthValidator,django.contrib.auth.password_validation.CommonPasswordValidator,django.contrib.auth.password_validation.NumericPasswordValidator

# ----------------------------------------------------------------------------
# External Services (Optional)
# ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

OPENCAGE_API_KEY=
OPENCAGE_BASE_URL=https://api.opencagedata.com/geocode/v1

# ----------------------------------------------------------------------------
# Monitoring and Analytics
# ----------------------------------------------------------------------------
ENABLE_ANALYTICS=False
GOOGLE_ANALYTICS_ID=

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
FEATURE_JWT_AUTH=False
FEATURE_OAUTH_GOOGLE=False
FEATURE_OAUTH_GITHUB=False
FEATURE_WEBSOCKETS=False
FEATURE_REALTIME_ALERTS=False

# ----------------------------------------------------------------------------
# Development Only
# ----------------------------------------------------------------------------
DJANGO_DEBUG_TOOLBAR=False
SHOW_SQL_QUERIES=False
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1